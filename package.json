    "start": "tsx apps/api/src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preflight": "tsx ops/cli.ts preflight",
    "seed-demo": "tsx ops/cli.ts seed-demo",
    "backup": "tsx ops/cli.ts backup",
    "restore-test": "tsx ops/cli.ts restore-test",
    "verify-bundle": "tsx ops/cli.ts verify-bundle",
    "benchmark": "tsx ops/benchmark.ts",
    "benchmark:worker": "tsx ops/benchmark-worker.ts",
    "compare-offline": "tsx ops/compare-offline-plans.ts",
    "test:android": "tsx ops/verify-android.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@noble/curves": "2.4.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@sinclair/typebox": "0.34.52",
    "@xyflow/react": "12.12.0",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "dexie": "4.4.6",
    "elkjs": "0.12.0",
    "fastify": "5.12.5",
    "highs": "1.15.3",
    "lucide-react": "1.51.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.38.2",
    "concurrently": "10.0.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
